# 杏临汇服务平台 · 后端环境变量示例（复制为 .env 后按需修改）
APP_NAME=杏临汇服务平台
# 安全默认值：复制后无法直接启动；本地演示须显式改为 dev，部署须改为 prod 并补齐真实凭据
APP_ENV=staging

# ───────── 生产域名规划（2026-09-22 定稿）─────────
# 主域：singlin.cn（2026-09-23 注册，备案主体：健树科技（天津）有限公司）
#   mp.singlin.cn     → API + WebSocket（小程序/H5 共用，Nginx 反代 8000）
#   essay.singlin.cn  → 征文 H5 静态站
#   admin.singlin.cn  → 管理后台静态站
# 小程序服务器域名配置：https://mp.singlin.cn + wss://mp.singlin.cn

# 数据库（本地 docker PostgreSQL；生产换 RDS 内网地址）
DATABASE_URL=postgresql+asyncpg://jianshu:jianshu@localhost:5432/jianshu

# Redis（缓存 / 限流 / Celery Broker）
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET=please-change-me-in-production
JWT_ACCESS_TOKEN_MINUTES=120
JWT_REFRESH_TOKEN_DAYS=7

# CORS（JSON 数组格式；本地开发用 localhost，生产加两个正式域）
# 生产示例：
# CORS_ORIGINS=["https://essay.singlin.cn","https://admin.singlin.cn"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# 上传
UPLOAD_DIR=./uploads
STORAGE_DRIVER=local

# 职业健康科普投稿：附件只存私有目录，绝不可设在 UPLOAD_DIR 内；默认关闭。
# 上线前须完成告知/评审责任、Redis 限流、DOCX/MP4 实测及私有下载验收后显式开启。
OCCUPATIONAL_SUBMISSION_DIR=./private_occupational_submissions
OCCUPATIONAL_SUBMISSIONS_ENABLED=false
# 药品说明书原件仅供内部核验，私有目录绝不可放进公开 UPLOAD_DIR。
DRUG_LEAFLET_DIR=./private_drug_leaflets
# 服务器需安装 ffprobe；缺失时视频投稿返回 503，不会跳过媒体校验。
FFPROBE_BIN=ffprobe

# 微信小程序（mp.weixin.qq.com → 开发管理 → 开发设置）
WX_APPID=
WX_SECRET=

# 阿里云 OSS（STORAGE_DRIVER=oss 时启用，预留）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=

# 杏临千行志愿者报名（公开填报；开放前确认隐私告知）
VOLUNTEER_APPLICATIONS_ENABLED=false

# ── 服务包交易（工作一，2026-10-22）──
# 微信支付 v3 直连商户：六项全部配置才开放微信支付；缺任一项时下单返回
# 503「支付通道未开通」、回调一律拒绝并审计。私钥/平台证书只从文件读取。
# WXPAY_PLATFORM_CERT_PATH 支持平台证书 PEM 或公钥 PEM 两种格式。
WXPAY_MCHID=
WXPAY_API_V3_KEY=
WXPAY_CERT_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_PLATFORM_CERT_PATH=
WXPAY_NOTIFY_URL=https://mp.singlin.cn/api/v1/pay/wxpay/notify
# 待支付订单超时（分钟）；超时懒关闭，支付成功晚到仍可入账
COMMERCE_ORDER_TTL_MINUTES=30
# 单位名单原件私有目录（含手机号，禁止置于公开 UPLOAD_DIR 内）与导入上限
COMMERCE_BATCH_DIR=./private_commerce_batches
COMMERCE_BATCH_FILE_MAX_BYTES=2097152
COMMERCE_BATCH_MAX_ROWS=10000

# ── 服务履约（工作二，2026-10-22）────────────────────────────
# 服务期天数（激活时快照到实例）与随访节点
STEWARD_SERVICE_DAYS=45
STEWARD_FOLLOWUP_DAYS=7,14,21,28,35,42
# 授权条款由后台 steward_consent_terms 表版本化管理（S1）；
# 原 STEWARD_*_CONSENT_TEXT 配置已废止。
# 触达（切片 B）：人工驳回重办上限
STEWARD_OUTREACH_MAX_ATTEMPTS=3
# 设备云数据（切片 C）：晚到窗口（天）与连续同步失败上限
STEWARD_DEVICE_LATE_DAYS=7
STEWARD_DEVICE_MAX_SYNC_FAILURES=5
# CCC 电话（切片 E）：真实外呼关闭；回调验签密钥为空即拒收（仅生产注入，不入库）
STEWARD_PHONE_MAX_ATTEMPTS=3
STEWARD_PHONE_RETRY_DELAY_MINUTES=30
STEWARD_PHONE_CCC_SECRET=
