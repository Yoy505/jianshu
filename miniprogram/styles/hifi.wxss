.hf .card + .card{margin-top:0}.hf .section-title::before{display:none;content:none}.hf .card-foot .text-action{margin-left:auto}.hf .hf-back{min-width:11.282051283vw}.hf .empty-card .primary,.hf .empty-card .secondary{min-width:36.410256411vw}.hf .star-row button{width:11.282051283vw}.hf .letter-rail button{width:5.128205129vw}.hf .search button{min-width:8.205128206vw}.hf .composer button{width:15.897435898vw}.hf .actions>button{flex:1;min-width:0}.hf .kv .t-b{overflow-wrap:anywhere}.hf .hf-nav-title{padding-right:0}

