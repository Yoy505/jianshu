<view class="page page-list">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-icon"></view>
    <input
      class="search-input"
      placeholder="搜索服务，如：上门护理、用药咨询"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
    <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">清除</view>
  </view>

  <!-- 场景横向筛选 chips -->
  <scroll-view scroll-x class="chip-scroll" enhanced show-scrollbar="{{false}}">
    <view class="chip-scroll-inner">
      <view
        class="hchip {{activeKey === item.key ? 'on' : ''}}"
        wx:for="{{chips}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onChip"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 骨架 -->
  <block wx:if="{{loading && !list.length}}">
    <view class="skeleton" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="sk-line first sk-w60"></view>
      <view class="sk-line sk-w80"></view>
      <view class="sk-line sk-w40"></view>
    </view>
  </block>

  <!-- 错误 -->
  <view class="card" wx:elif="{{error && !list.length}}">
    <view class="empty">
      <view class="empty-art"></view>
      <view class="empty-title">{{error}}</view>
      <view class="empty-btn btn-mini" bindtap="reload">重新加载</view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="card" wx:elif="{{!list.length}}">
    <view class="empty">
      <view class="empty-art"></view>
      <view class="empty-title">暂无匹配的服务</view>
      <view class="empty-desc">换个筛选条件或关键词试试</view>
    </view>
  </view>

  <!-- 服务列表 -->
  <block wx:else>
    <view
      class="card service-card fade-in"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="row-between">
        <view class="service-name ellipsis">{{item.name}}</view>
        <view class="tag {{item.typeCls}} service-type">{{item.typeLabel}}</view>
      </view>
      <view class="service-desc ellipsis-2">{{item.desc}}</view>
      <view class="service-meta t3">演示资料 · 参考时长 {{item.duration}} · 人员资料 {{item.providerCount}} 条</view>
      <view class="row-between service-bottom">
        <view class="price">
          <text class="price-symbol">参考 ¥</text>{{item.price}}<text class="price-unit">/{{item.unit}}</text>
        </view>
        <view class="btn-mini">查看详情</view>
      </view>
    </view>

    <view class="load-tip" wx:if="{{loading}}">正在加载…</view>
    <view class="load-tip" wx:elif="{{finished && list.length}}">没有更多了</view>
  </block>
</view>
