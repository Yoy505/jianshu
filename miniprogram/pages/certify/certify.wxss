/* 入驻通道未接通前，仅展示准确的开放状态和后续流程。 */
.ct-status-card { padding-top: 40rpx; padding-bottom: 40rpx; }
.ct-status-title { margin-top: 24rpx; font-size: 34rpx; font-weight: 700; }
.ct-status-desc { margin-top: 16rpx; font-size: 26rpx; line-height: 1.7; }
.ct-line { display: flex; margin-top: 20rpx; font-size: 26rpx; color: #6B7280; line-height: 1.7; }
.ct-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #0F766E; margin: 16rpx 16rpx 0 0; flex-shrink: 0; }
.ct-back { margin-top: 40rpx; }
