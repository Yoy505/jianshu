<block wx:if="{{!accessBlocked}}">
<view class="hf {{(hfReviewEligible) ? 'has-actions' : ''}}" style="padding-top:calc(14.871794872vw + {{hfStatus}}px)">
  <view class="hf-nav" style="top:0">
    <view class="hf-status" style="height:{{hfStatus}}px">
    </view>
    <view class="hf-nav-inner" >
      <button class="hf-back" bindtap="hfBack" >返回</button>
      <view class="hf-nav-title" >{{hfTitle}}</view>
    </view>
  </view>
  <block wx:if="{{needLogin}}">
    <view class="hero with-icon" >
      <text class="eyebrow">杏临汇 · 个人服务</text>
      <view class="t-h1" >登录后继续</view>
      <view class="t-p " >个人记录仅向当前登录账户展示</view>
      <view class="hero-icon" >
        <text class="ph ph-lock-key">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-user-circle">
        </text>
        <view class="t-h2" >登录后查看{{hfTitle}}</view>
        <view class="t-p hf-empty-text" >前往「我的」完成登录后，再回来查看相关信息。</view>
        <button class="primary" bindtap="hfGo" data-url="/pages/my/my">前往登录</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:elif="{{loading && (!list || !list.length)}}">
    <view class="pad" >
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{(error && (!list || !list.length)) || statusUnavailable}}">
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-cloud-slash">
        </text>
        <view class="t-h2" >暂时无法加载内容</view>
        <view class="t-p hf-empty-text" >{{error || statusMessage}}</view>
        <button class="secondary" bindtap="hfRetry" >重新加载</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:else>
    <view class="hero with-icon" >
      <text class="eyebrow">服务反馈 · 真诚评价</text>
      <view class="t-h1" >记录你的服务感受</view>
      <view class="t-p " >评价入口仅适用于符合条件的服务记录</view>
      <view class="hero-icon" >
        <text class="ph ph-star">
        </text>
      </view>
    </view>
    <view class="pad" >
      <block wx:if="{{hfReviewEligible}}">
        <view class="notice">
          <text class="ph ph-info">
          </text>
          <view class="t-p">请根据已完成服务的实际体验评价，不填写隐私信息。</view>
        </view>
        <view class="card review-card" >
          <view class="t-h2 center" >为本次服务评分</view>
          <view class="star-row" >
            <button class="{{item ? 'selected' : ''}}" bindtap="setRating" wx:for="{{stars}}" wx:key="index" data-n="{{index+1}}" aria-label="{{index+1}}星">
              <text class="ph ph-star">
              </text>
            </button>
          </view>
          <view class="t-p center" >{{ratingText || '点击星星打分'}}</view>
          <view class="field" >
            <view class="t-label" >文字评价（选填）</view>
            <textarea value="{{content}}" bindinput="onContent" placeholder="说说服务过程与感受" maxlength="200" />
          </view>
          <view class="t-p small counter" >{{content.length}} / 200</view>
        </view>
        <view class="card " >
          <view class="t-h2" >评价说明</view>
          <view class="t-p " >请围绕服务过程与体验反馈，避免填写个人病情、联系方式等隐私信息。</view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-card" >
          <text class="ph ph-star">
          </text>
          <view class="t-h2" >暂无可评价的服务</view>
          <view class="t-p hf-empty-text" >完成服务后，可从「我的预约」进入评价。</view>
          <button class="secondary" bindtap="hfGo" data-url="/pages/appointments/appointments">查看我的预约</button>
        </view>
      </block>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <view class="actions" wx:if="{{hfReviewEligible}}">
    <button class="primary" bindtap="submit" disabled="{{submitting}}">{{submitting ? '提交中…' : '提交评价'}}</button>
  </view>
</view>

</block>
