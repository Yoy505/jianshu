<block wx:if="{{!accessBlocked}}">
<view class="hf" style="padding-top:{{hfStatus}}px">
  <view class="hf-nav hf-status">
    <view class="hf-nav-inner">
      <button class="hf-back" bindtap="hfBack">返回</button>
      <view class="hf-nav-title">{{hfTitle}}</view>
    </view>
  </view>

  <view class="pad">
    <view class="chips">
      <button wx:for="{{tabs}}" wx:key="key" class="{{active === item.key ? 'active' : ''}}"
        bindtap="onTab" data-v="{{item.key}}">{{item.label}}</button>
    </view>

    <block wx:if="{{loading && !list.length}}">
      <view class="skeleton"><view class="t-span"></view><view class="t-span"></view><view class="t-span"></view></view>
      <view class="skeleton"><view class="t-span"></view><view class="t-span"></view><view class="t-span"></view></view>
    </block>

    <view wx:elif="{{error && !list.length}}" class="empty-card">
      <text class="ph ph-cloud-slash"></text>
      <view class="t-h2">订单加载失败</view>
      <view class="t-p">{{error}}</view>
      <button class="secondary" bindtap="hfRetry">重新加载</button>
    </view>

    <view wx:elif="{{!list.length}}" class="empty-card">
      <text class="ph ph-receipt"></text>
      <view class="t-h2">暂无相关订单</view>
      <view class="t-p">可在健康商城查看可购买的服务包</view>
    </view>

    <block wx:else>
      <button class="card order-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="row between">
          <view class="t-h3 grow">{{item.packageName}}</view>
          <text class="badge {{item.status === 'paid' ? 'teal' : ''}}">{{item.statusLabel}}</text>
        </view>
        <view class="kv"><text class="t-span">订单编号</text><text class="t-b">{{item.orderNo}}</text></view>
        <view class="kv"><text class="t-span">{{item.payTypeLabel}}</text><text class="t-b order-amount">{{item.amount}}</text></view>
        <view class="kv"><text class="t-span">下单时间</text><text class="t-b">{{item.time}}</text></view>
      </button>
      <view class="hf-more" wx:if="{{!finished}}">上拉加载更多</view>
      <view class="hf-more" wx:if="{{finished}}">共 {{total}} 单</view>
    </block>
  </view>
</view>
</block>
