/* 我的预约 */
.page-appts { padding-bottom: 40rpx; }
.stab-scroll { white-space: nowrap; }
.stab-inner { display: inline-block; }
.stab {
  display: inline-block;
  padding: 14rpx 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7280;
  margin-right: 16rpx;
  transition: all 150ms ease;
}
.stab.on { background: #0F766E; border-color: #0F766E; color: #FFFFFF; font-weight: 600; }
.skeleton { margin-top: 20rpx; }
.appt-card { margin-top: 20rpx; }
.appt-name { font-size: 30rpx; font-weight: 600; flex: 1; margin-right: 16rpx; }
.appt-card .tag { margin-right: 0; }
.appt-line { margin-top: 10rpx; font-size: 26rpx; }
.appt-actions { justify-content: flex-end; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #F0F1F2; }
.appt-actions .btn-mini + .btn-mini { margin-left: 16rpx; }
