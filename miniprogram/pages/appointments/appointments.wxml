<view class="page page-appts">
  <!-- 未登录 -->
  <view class="card" wx:if="{{needLogin}}">
    <view class="empty">
      <view class="empty-art"></view>
      <view class="empty-title">登录后查看你的预约</view>
      <view class="empty-btn btn-mini" bindtap="goLogin">去登录</view>
    </view>
  </view>

  <block wx:else>
    <!-- 状态 tabs -->
    <scroll-view scroll-x class="stab-scroll" enhanced show-scrollbar="{{false}}">
      <view class="stab-inner">
        <view
          class="stab {{active === item.v ? 'on' : ''}}"
          wx:for="{{tabs}}"
          wx:key="v"
          data-v="{{item.v}}"
          bindtap="onTab"
        >{{item.n}}</view>
      </view>
    </scroll-view>

    <!-- 骨架 -->
    <block wx:if="{{loading && !list.length}}">
      <view class="skeleton" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="sk-line first sk-w60"></view>
        <view class="sk-line sk-w80"></view>
        <view class="sk-line sk-w40"></view>
      </view>
    </block>

    <!-- 错误 -->
    <view class="card" wx:elif="{{error && !list.length}}">
      <view class="empty">
        <view class="empty-art"></view>
        <view class="empty-title">{{error}}</view>
        <view class="empty-btn btn-mini" bindtap="reload">重新加载</view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="card" wx:elif="{{!list.length}}">
      <view class="empty">
        <view class="empty-art"></view>
        <view class="empty-title">暂无相关预约</view>
        <view class="empty-desc">去管家选一个场景，开始健康守护</view>
        <view class="empty-btn btn-mini" bindtap="goSteward">去逛管家</view>
      </view>
    </view>

    <!-- 预约列表 -->
    <block wx:else>
      <view class="card appt-card fade-in" wx:for="{{list}}" wx:key="id">
        <view class="row-between">
          <view class="appt-name ellipsis">{{item.serviceName}}</view>
          <view class="tag {{item.statusCls}}">{{item.statusLabel}}</view>
        </view>
        <view class="appt-line t2">服务人员：{{item.providerName}}</view>
        <view class="appt-line t2">预约时间：{{item.date}} {{item.period}}</view>
        <view class="appt-line t2 ellipsis" wx:if="{{item.address}}">服务地址：{{item.address}}</view>
        <view class="appt-line t3 f-note">提交时间：{{item.time}}</view>
        <view class="row appt-actions" wx:if="{{item.canCancel || item.canReview}}">
          <view class="btn-mini btn-danger" wx:if="{{item.canCancel}}" data-id="{{item.id}}" catchtap="cancel">取消预约</view>
          <view class="btn-mini" wx:if="{{item.canReview}}" data-id="{{item.id}}" catchtap="review">去评价</view>
        </view>
      </view>

      <view class="load-tip" wx:if="{{loading}}">正在加载…</view>
      <view class="load-tip" wx:elif="{{finished && list.length}}">没有更多了</view>
    </block>
  </block>
</view>
