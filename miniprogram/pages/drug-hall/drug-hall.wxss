/* 药品数字展厅 */
.page-hall { padding-bottom: 40rpx; }

.search-bar {
  background: #FFFFFF;
  border-radius: 999rpx;
  border: 1rpx solid #EDF0EF;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 80rpx;
}
.search-icon {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #9CA3AF;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}
.search-icon::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  background: #9CA3AF;
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.search-input { flex: 1; margin-left: 16rpx; font-size: 26rpx; height: 100%; }
.search-clear { font-size: 24rpx; color: #0F766E; padding: 10rpx 0 10rpx 16rpx; }

.chip-scroll { margin-top: 20rpx; white-space: nowrap; }
.chip-scroll-inner { display: inline-block; }
.hchip {
  display: inline-block;
  padding: 12rpx 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7280;
  margin-right: 16rpx;
  transition: all 150ms ease;
}
.hchip.on { background: #0F766E; border-color: #0F766E; color: #FFFFFF; font-weight: 600; }

.hall-body { margin-top: 20rpx; padding-right: 40rpx; }
.skeleton + .skeleton { margin-top: 20rpx; }
.drug-card { margin-bottom: 20rpx; }
.drug-name { font-size: 30rpx; font-weight: 600; flex: 1; }
.drug-tags { margin-top: 12rpx; flex-wrap: wrap; }
.drug-sub { margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.drug-meta { margin-top: 8rpx; font-size: 23rpx; color: #667C74; line-height: 1.5; word-break: break-all; }
.drug-publication { display: inline-block; margin-top: 14rpx; padding: 7rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 600; }
.drug-publication.demo { background: #FFF1E5; color: #A45313; border: 1rpx solid #F3D6B7; }
.drug-publication.published { background: #E8F3EF; color: #0F766E; }
.drug-publication.unknown { background: #F2F4F3; color: #596A64; }
.drug-demo-notice { margin-bottom: 18rpx; padding: 18rpx 22rpx; border-radius: 12rpx; background: #FFF3E7; color: #8F4A10; font-size: 24rpx; line-height: 1.55; }
.official-query-tip { margin-top: 18rpx; font-size: 23rpx; color: #667C74; line-height: 1.5; }
.official-query-copy { display: inline-flex; align-items: center; min-height: 88rpx; margin-top: 18rpx; padding: 0 22rpx; color: #0F766E; background: #E8F3EF; border-radius: 10rpx; font-size: 24rpx; font-weight: 600; }

/* 字母索引右侧条 */
.letter-rail {
  position: fixed;
  right: 6rpx;
  top: 320rpx;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  z-index: 20;
}
.letter {
  font-size: 20rpx;
  color: #6B7280;
  width: 36rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.letter.on { color: #0F766E; font-weight: 700; }
