/* 人员匹配列表 */
.page-providers { padding-bottom: 40rpx; }
.skeleton + .skeleton { margin-top: 20rpx; }
.provider-card { margin-top: 20rpx; }

.p-avatar, .p-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.p-avatar {
  background: linear-gradient(135deg, #0F766E, #14B8A6);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-base { min-width: 0; }
.p-name { font-size: 32rpx; font-weight: 600; }
.p-online { margin-left: 16rpx; font-size: 22rpx; color: #15803D; display: flex; align-items: center; }
.p-online.off { color: #9CA3AF; }
.p-title { margin-top: 6rpx; font-size: 24rpx; color: #6B7280; }
.p-rating { text-align: center; margin-left: 16rpx; flex-shrink: 0; }
.p-score { font-size: 34rpx; font-weight: 700; color: #D97706; }
.p-score-label { font-size: 20rpx; color: #9CA3AF; }
.p-org { margin-top: 16rpx; font-size: 26rpx; }
.p-meta { margin-top: 8rpx; font-size: 24rpx; }
.p-skills { margin-top: 16rpx; flex-wrap: wrap; }
.p-verified { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #F0F1F2; }
