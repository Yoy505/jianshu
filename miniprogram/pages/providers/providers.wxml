<block wx:if="{{!accessBlocked}}">
<view class="hf " style="padding-top:calc(14.871794872vw + {{hfStatus}}px)">
  <view class="hf-nav" style="top:0">
    <view class="hf-status" style="height:{{hfStatus}}px">
    </view>
    <view class="hf-nav-inner" >
      <button class="hf-back" bindtap="hfBack" >返回</button>
      <view class="hf-nav-title" >{{hfTitle}}</view>
    </view>
  </view>
  <block wx:if="{{needLogin}}">
    <view class="hero with-icon" >
      <text class="eyebrow">杏临汇 · 个人服务</text>
      <view class="t-h1" >登录后继续</view>
      <view class="t-p " >个人记录仅向当前登录账户展示</view>
      <view class="hero-icon" >
        <text class="ph ph-lock-key">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-user-circle">
        </text>
        <view class="t-h2" >登录后查看{{hfTitle}}</view>
        <view class="t-p hf-empty-text" >前往「我的」完成登录后，再回来查看相关信息。</view>
        <button class="primary" bindtap="hfGo" data-url="/pages/my/my">前往登录</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:elif="{{loading && (!list || !list.length)}}">
    <view class="pad" >
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{(error && (!list || !list.length)) || statusUnavailable}}">
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-cloud-slash">
        </text>
        <view class="t-h2" >暂时无法加载内容</view>
        <view class="t-p hf-empty-text" >{{error || statusMessage}}</view>
        <button class="secondary" bindtap="hfRetry" >重新加载</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:else>
    <view class="hero with-icon" >
      <text class="eyebrow">服务人员 · 资料展示</text>
      <view class="t-h1" >了解服务人员</view>
      <view class="t-p " >{{hfServiceName || '了解相关人员的资料与服务方向'}}</view>
      <view class="hero-icon" >
        <text class="ph ph-users">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="notice " >
        <text class="ph ph-info">
        </text>
        <view class="t-p " >身份与执业资质尚待核验，演示资料不代表已开通服务。</view>
      </view>
      <view class="section-head" >
        <view class="t-h2" >相关人员资料</view>
        <text class="t-small">{{list.length ? total + ' 条资料' : '暂无资料'}}</text>
      </view>
      <block wx:if="{{list.length}}">
        <view class="card person-card" wx:for="{{list}}" wx:key="id">
          <view class="row" >
            <view class="avatar {{index % 2 ? 'gold' : ''}}" >
              <text class="ph ph-user-circle">
              </text>
            </view>
            <view class="grow" >
              <view class="t-h3" >{{item.name}}</view>
              <view class="t-p " >{{item.dept || '健康管理相关方向'}}</view>
            </view>
            <text class="badge">资料待核验</text>
          </view>
          <view class="t-p small" >职称、执业单位与从业年限待核验</view>
          <view class="tags" >
            <text class="t-span" wx:for="{{item.skills}}" wx:for-item="skill" wx:key="*this">{{skill}}</text>
          </view>
          <view class="card-foot" >
            <text class="t-span">尚未完成资质核验</text>
            <button class="text-action" bindtap="goDetail" data-id="{{item.id}}">查看资料</button>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-card" >
          <text class="ph ph-users">
          </text>
          <view class="t-h2" >暂无匹配的专业人员</view>
          <view class="t-p hf-empty-text" >人员资料正在完善，请稍后查看。</view>
          <button class="secondary" bindtap="hfBack" >返回服务说明</button>
        </view>
      </block>
      <view class="card " >
        <view class="t-h2" >先了解，再作选择</view>
        <view class="t-p " >查看人员介绍时，请留意身份、资质与服务范围的核验状态。</view>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <view class="hf-pagination" wx:if="{{list.length && (loading || error)}}">
    <text wx:if="{{loading}}">正在加载更多…</text>
    <button wx:else bindtap="hfRetry">{{error}} · 重新加载</button>
  </view>
</view>

</block>
