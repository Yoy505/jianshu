/* 咚咚聊天 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F7F6;
}
.chat-tip { border-radius: 0; flex-shrink: 0; }
.chat-body { flex: 1; padding: 24rpx; overflow: hidden; }
.chat-sk { margin-top: 24rpx; }

.msg-scroll { flex: 1; overflow: hidden; padding: 24rpx 24rpx 0; box-sizing: border-box; }
.msg-pad-top { height: 8rpx; }
.msg-pad-bottom { height: 32rpx; }

.sys-hint {
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  background: #EDF0EF;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  width: fit-content;
  margin: 16rpx auto;
}

.msg-row { display: flex; margin-top: 24rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.provider { justify-content: flex-start; }

.msg-system {
  width: 88%;
  margin: 0 auto;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #EAF1EF;
  color: #405A54;
  font-size: 24rpx;
  line-height: 1.6;
}
.msg-system-label { font-size: 22rpx; font-weight: 600; margin-bottom: 6rpx; }
.msg-system-time { font-size: 20rpx; opacity: 0.65; margin-top: 8rpx; }
.bubble-origin { font-size: 20rpx; color: #7A8580; margin-bottom: 8rpx; }

.bubble { max-width: 76%; border-radius: 20rpx; padding: 20rpx 24rpx; }
.bubble-user {
  background: #0F766E;
  color: #FFFFFF;
  border-top-right-radius: 4rpx;
}
.bubble-provider {
  background: #FFFFFF;
  color: #1F2937;
  border-top-left-radius: 4rpx;
  border: 1rpx solid #EDF0EF;
}
.bubble-text { font-size: 28rpx; line-height: 1.6; word-break: break-all; }
.bubble-time { margin-top: 8rpx; font-size: 20rpx; opacity: 0.65; }

/* 正在输入 */
.typing-bubble { display: flex; align-items: center; }
.tdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9CA3AF;
  margin-right: 10rpx;
  animation: typing-blink 1s ease-in-out infinite;
}
.tdot.d2 { animation-delay: 0.2s; }
.tdot.d3 { animation-delay: 0.4s; }
.typing-text { font-size: 24rpx; color: #9CA3AF; margin-left: 4rpx; }
@keyframes typing-blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* 输入区 */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-top: 1rpx solid #EDF0EF;
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
}
.chat-input {
  flex: 1;
  height: 80rpx;
  background: #F3F6F5;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  height: 80rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #0F766E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 150ms ease, opacity 150ms ease;
}
.send-btn:active { transform: scale(0.97); }
.send-btn.disabled { opacity: 0.5; }

/* 通道状态点：绿=WebSocket 实时，灰=轮询降级 */
.channel-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-left: 12rpx;
  background-color: #C9CDD2;
  vertical-align: middle;
  flex-shrink: 0;
}
.channel-dot.on { background-color: #34C759; }
.tip-text { flex: 1; }
.channel-dot { align-self: center; }
