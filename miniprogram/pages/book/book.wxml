<block wx:if="{{!accessBlocked}}">
<view class="hf {{(service && slots.length && !loading && !error) ? 'has-actions' : ''}}" style="padding-top:calc(14.871794872vw + {{hfStatus}}px)">
  <view class="hf-nav" style="top:0">
    <view class="hf-status" style="height:{{hfStatus}}px">
    </view>
    <view class="hf-nav-inner" >
      <button class="hf-back" bindtap="hfBack" >返回</button>
      <view class="hf-nav-title" >{{hfTitle}}</view>
    </view>
  </view>
  <block wx:if="{{needLogin}}">
    <view class="hero with-icon" >
      <text class="eyebrow">杏临汇 · 个人服务</text>
      <view class="t-h1" >登录后继续</view>
      <view class="t-p " >个人记录仅向当前登录账户展示</view>
      <view class="hero-icon" >
        <text class="ph ph-lock-key">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-user-circle">
        </text>
        <view class="t-h2" >登录后查看{{hfTitle}}</view>
        <view class="t-p hf-empty-text" >前往「我的」完成登录后，再回来查看相关信息。</view>
        <button class="primary" bindtap="hfGo" data-url="/pages/my/my">前往登录</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:elif="{{loading && (!list || !list.length)}}">
    <view class="pad" >
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{(error && (!list || !list.length)) || statusUnavailable}}">
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-cloud-slash">
        </text>
        <view class="t-h2" >暂时无法加载内容</view>
        <view class="t-p hf-empty-text" >{{error || statusMessage}}</view>
        <button class="secondary" bindtap="hfRetry" >重新加载</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:else>
    <view class="hero with-icon" >
      <text class="eyebrow">预约服务 · 流程说明</text>
      <view class="t-h1" >{{slots.length ? '预约流程体验' : '预约暂未开放'}}</view>
      <view class="t-p " >{{slots.length ? '当前为演示表单，不提交真实服务申请' : '真实排班尚未接入，请留意服务开放状态'}}</view>
      <view class="hero-icon" >
        <text class="ph ph-calendar-blank">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="summary" >
        <view class="row" >
          <text class="ph ph-clipboard-text">
          </text>
          <view class="" >
            <view class="t-h3" >{{service.name || '健康服务'}}</view>
            <view class="t-p " >{{provider.name || '人员待确认'}} · 资料待核验</view>
          </view>
        </view>
      </view>
      <block wx:if="{{slots.length}}">
        <view class="notice " >
          <text class="ph ph-info">
          </text>
          <view class="t-p " >日期与时段仅为演示，请勿填写真实联系信息。</view>
        </view>
        <view class="card " >
          <view class="t-h2" >演示预约日期</view>
          <view class="chips" >
            <button class="{{selectedDate === item.date ? 'active' : ''}}" bindtap="selectDate" wx:for="{{slots}}" wx:key="date" data-date="{{item.date}}">{{item.label}}</button>
          </view>
          <view class="chips" >
            <button class="{{selectedPeriod === item ? 'active' : ''}}" bindtap="selectPeriod" wx:for="{{periodOptions}}" wx:key="*this" data-period="{{item}}">{{item}}</button>
          </view>
        </view>
        <view class="card " >
          <view class="t-h2" >联系信息</view>
          <view class="field" >
            <view class="t-label" >联系人</view>
            <input value="{{contactName}}" bindinput="onName" placeholder="请填写演示姓名"  />
          </view>
          <view class="field" >
            <view class="t-label" >联系电话</view>
            <input value="{{contactPhone}}" bindinput="onPhone" placeholder="仅用于界面演示" type="number" maxlength="11" />
          </view>
          <view class="" wx:if="{{!service.isOnline}}">
            <view class="field" >
              <view class="t-label" >服务地址</view>
              <input value="{{address}}" bindinput="onAddress" placeholder="填写演示服务地址"  />
            </view>
          </view>
          <view class="field" >
            <view class="t-label" >备注（选填）</view>
            <textarea value="{{remark}}" bindinput="onRemark" placeholder="填写演示备注" maxlength="200" />
          </view>
        </view>
        <view class="card " >
          <view class="t-h2" >费用说明</view>
          <view class="t-p " >参考费用 {{service.price || '待确认'}} {{service.unit}}；页面内容不构成付款承诺。</view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-card" >
          <text class="ph ph-calendar-blank">
          </text>
          <view class="t-h2" >暂无可预约时段</view>
          <view class="t-p hf-empty-text" >当前不接受真实预约提交，
            无需填写姓名、电话或地址。</view>
            <button class="secondary" bindtap="hfBack" >返回人员资料</button>
          </view>
          <view class="card " >
            <view class="t-h2" >开放后可查看</view>
            <view class="step" >
              <text class="t-span">01</text>
              <view class="" >
                <view class="t-h3" >选择日期与时段</view>
                <view class="t-p " >以服务人员的实际排班为准</view>
              </view>
            </view>
            <view class="step" >
              <text class="t-span">02</text>
              <view class="" >
                <view class="t-h3" >确认服务信息</view>
                <view class="t-p " >了解服务主体、费用与履约安排</view>
              </view>
            </view>
          </view>
        </block>
        <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
      </view>
    </block>
    <view class="actions" wx:if="{{service && slots.length && !loading && !error}}">
      <button class="primary" bindtap="submit" disabled="{{submitting}}">{{submitting ? '提交中…' : '提交演示预约'}}</button>
    </view>
  </view>

</block>
