<view class="page page-cl">
  <!-- 未登录 -->
  <view class="card" wx:if="{{needLogin}}">
    <view class="empty">
      <view class="empty-art"></view>
      <view class="empty-title">登录后查看你的咨询会话</view>
      <view class="empty-btn btn-mini" bindtap="goLogin">去登录</view>
    </view>
  </view>

  <block wx:else>
    <!-- 骨架 -->
    <block wx:if="{{loading && !list.length}}">
      <view class="skeleton" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="sk-line first sk-w40"></view>
        <view class="sk-line sk-w80"></view>
      </view>
    </block>

    <!-- 错误 -->
    <view class="card" wx:elif="{{error && !list.length}}">
      <view class="empty">
        <view class="empty-art"></view>
        <view class="empty-title">{{error}}</view>
        <view class="empty-btn btn-mini" bindtap="reload">重新加载</view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="card" wx:elif="{{!list.length}}">
      <view class="empty">
        <view class="empty-art"></view>
        <view class="empty-title">暂无咨询会话</view>
        <view class="empty-desc">目前仅可体验系统自动回执，真人咨询尚未接入</view>
        <view class="empty-btn btn-mini" bindtap="goSteward">去找专业人员</view>
      </view>
    </view>

    <!-- 会话列表 -->
    <block wx:else>
      <view class="card cl-card fade-in" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goChat">
        <view class="cl-avatar">{{item.providerName[0]}}</view>
        <view class="flex-1 cl-bd">
          <view class="row">
            <view class="cl-name ellipsis">{{item.providerName}}</view>
            <view class="tag {{item.statusCls}} cl-status">{{item.statusLabel}}</view>
          </view>
          <view class="cl-last ellipsis t2">{{item.lastMsg}}</view>
        </view>
        <view class="cl-time t3">{{item.time}}</view>
      </view>

      <view class="load-tip" wx:if="{{loading}}">正在加载…</view>
      <view class="load-tip" wx:elif="{{finished && list.length}}">没有更多了</view>
    </block>
  </block>
</view>
