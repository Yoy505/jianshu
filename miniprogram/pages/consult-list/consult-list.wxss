/* 咨询会话列表 */
.page-cl { padding-bottom: 40rpx; }
.skeleton { margin-top: 20rpx; }
.skeleton + .skeleton { margin-top: 20rpx; }
.cl-card { margin-top: 20rpx; display: flex; align-items: center; }
.cl-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E6F2F0;
  color: #0F766E;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.cl-bd { min-width: 0; }
.cl-name { font-size: 30rpx; font-weight: 600; max-width: 300rpx; }
.cl-status { margin-left: 16rpx; margin-right: 0; }
.cl-last { margin-top: 8rpx; font-size: 26rpx; }
.cl-time { margin-left: 12rpx; font-size: 22rpx; flex-shrink: 0; align-self: flex-start; margin-top: 6rpx; }
