.legal-page {
  padding: 32rpx 32rpx 64rpx;
  background-color: #FFFFFF;
  min-height: 100vh;
  box-sizing: border-box;
}

.legal-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.3;
}

.legal-updated {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

.legal-intro {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4B5563;
}

.legal-section {
  margin-top: 40rpx;
}

.legal-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.legal-p {
  font-size: 28rpx;
  line-height: 1.7;
  color: #4B5563;
  margin-bottom: 10rpx;
  text-align: justify;
}

.legal-footer {
  margin-top: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
}
