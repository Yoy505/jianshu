/* 健康档案 */
.pf-note { border-radius: 12rpx; }
.pf-gender { margin-top: 12rpx; }
.pf-cols { display: flex; }
.pf-col-r { margin-left: 20rpx; }
.pf-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F2;
}
.pf-switch-label { font-size: 28rpx; color: #374151; }
.pf-save { margin-top: 40rpx; margin-bottom: 40rpx; }
.pf-status-detail { color: #6B7280; font-size: 26rpx; line-height: 1.6; }
.pf-read-row { display: flex; padding: 18rpx 0; border-bottom: 1rpx solid #F0F1F2; font-size: 26rpx; }
.pf-read-row:last-child { border-bottom: 0; }
.pf-read-label { width: 150rpx; flex-shrink: 0; color: #6B7280; }
.pf-read-value { flex: 1; min-width: 0; color: #1F2937; word-break: break-all; }
.pf-empty { color: #6B7280; font-size: 26rpx; }
.pf-retry { margin-top: 22rpx; display: inline-flex; }

/* 敏感信息单独同意提示 */
.consent-tip {
  margin: 24rpx 0 8rpx;
  padding: 20rpx 24rpx;
  background: #FBF3DB;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #956400;
  text-align: justify;
}

.consent-link {
  color: #0F766E;
}
