<block wx:if="{{!accessBlocked}}">
<wxs module="hf">module.exports.contains = function(a,b){ return a.indexOf(b) > -1; };</wxs>
<view class="hf {{(profileMode === 'demo' && !loading && !statusUnavailable) ? 'has-actions' : ''}}" style="padding-top:calc(14.871794872vw + {{hfStatus}}px)">
  <view class="hf-nav" style="top:0">
    <view class="hf-status" style="height:{{hfStatus}}px">
    </view>
    <view class="hf-nav-inner" >
      <button class="hf-back" bindtap="hfBack" >返回</button>
      <view class="hf-nav-title" >{{hfTitle}}</view>
    </view>
  </view>
  <block wx:if="{{needLogin}}">
    <view class="hero with-icon" >
      <text class="eyebrow">杏临汇 · 个人服务</text>
      <view class="t-h1" >登录后继续</view>
      <view class="t-p " >个人记录仅向当前登录账户展示</view>
      <view class="hero-icon" >
        <text class="ph ph-lock-key">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-user-circle">
        </text>
        <view class="t-h2" >登录后查看{{hfTitle}}</view>
        <view class="t-p hf-empty-text" >前往「我的」完成登录后，再回来查看相关信息。</view>
        <button class="primary" bindtap="hfGo" data-url="/pages/my/my">前往登录</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:elif="{{loading && (!list || !list.length)}}">
    <view class="pad" >
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{(error && (!list || !list.length)) || statusUnavailable}}">
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-cloud-slash">
        </text>
        <view class="t-h2" >暂无法确认档案状态</view>
        <view class="t-p hf-empty-text" >{{error || statusMessage}}</view>
        <button class="secondary" bindtap="hfRetry" >重新加载</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:else>
    <view class="hero with-icon" >
      <text class="eyebrow">个人健康 · 信息管理</text>
      <view class="t-h1" >健康档案</view>
      <view class="t-p " >已有档案仅本人查看，留意当前填写状态</view>
      <view class="hero-icon" >
        <text class="ph ph-identification-card">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="notice " >
        <text class="ph ph-info">
        </text>
        <view class="t-p " >{{profileMode === 'demo' ? '演示填写状态，不采集或保存真实健康信息。' : '当前不收集新的健康档案信息，也不接受修改。'}}</view>
      </view>
      <block wx:if="{{profileMode === 'demo'}}">
        <!-- 基础信息 -->
        <view class="card">
          <view class="t-h2">基础信息</view>
          <view class="field">
            <view class="t-label">姓名</view>
            <input class="input" placeholder="请填写演示姓名" value="{{form.name}}" data-field="name" bindinput="onField" maxlength="20" />
          </view>
          <view class="field">
            <view class="t-label">性别</view>
            <view class="chips pf-gender">
              <view class="hf-chip {{form.gender === 'male' ? 'active' : ''}}" data-v="male" bindtap="selectGender">男</view>
              <view class="hf-chip {{form.gender === 'female' ? 'active' : ''}}" data-v="female" bindtap="selectGender">女</view>
            </view>
          </view>
          <view class="field">
            <view class="t-label">出生年月</view>
            <picker mode="date" fields="month" value="{{form.birth}}" start="1900-01" end="{{maxBirth}}" bindchange="onBirth">
              <view class="picker-box">
                <view wx:if="{{form.birth}}">{{form.birth}}</view>
                <view wx:else class="placeholder">请选择出生年月</view>
              </view>
            </picker>
          </view>
        </view>

        <!-- 身体指标 -->
        <view class="card">
          <view class="t-h2">身体指标</view>
          <view class="field-row">
            <view class="field flex-1">
              <view class="t-label">身高（cm）</view>
              <input class="input" type="digit" placeholder="如 170" value="{{form.height}}" data-field="height" bindinput="onField" />
            </view>
            <view class="field flex-1 pf-col-r">
              <view class="t-label">体重（kg）</view>
              <input class="input" type="digit" placeholder="如 65" value="{{form.weight}}" data-field="weight" bindinput="onField" />
            </view>
          </view>
          <view class="field">
            <view class="t-label">血型</view>
            <picker range="{{bloods}}" value="{{bloodIndex}}" bindchange="onBlood">
              <view class="picker-box">
                <view wx:if="{{form.blood}}">{{form.blood}} 型</view>
                <view wx:else class="placeholder">请选择血型</view>
              </view>
            </picker>
          </view>
        </view>

        <!-- 健康状况 -->
        <view class="card">
          <view class="t-h2">健康状况</view>
          <view class="field">
            <view class="t-label">慢病标签（可多选）</view>
            <view class="chips chip-wrap">
              <view
                class="hf-chip {{hf.contains(form.chronicTags,c) ? 'active' : ''}}"
                wx:for="{{chronicOptions}}"
                wx:for-item="c"
                wx:key="*this"
                data-tag="{{c}}"
                bindtap="toggleChronic"
                >{{c}}</view>
              </view>
            </view>
            <view class="field">
              <view class="t-label">过敏史</view>
              <textarea class="textarea" placeholder="药物/食物过敏等（选填）" value="{{form.allergy}}" data-field="allergy" bindinput="onField" maxlength="200" />
            </view>
            <view class="field">
              <view class="t-label">手术史</view>
              <textarea class="textarea" placeholder="既往手术情况（选填）" value="{{form.surgery}}" data-field="surgery" bindinput="onField" maxlength="200" />
            </view>
          </view>

          <!-- 生活方式 -->
          <view class="card">
            <view class="t-h2">生活方式</view>
            <view class="pf-switch-row">
              <view class="pf-switch-label">吸烟</view>
              <switch checked="{{form.smoke}}" color="#0F766E" bindchange="onSmoke" />
            </view>
            <view class="pf-switch-row">
              <view class="pf-switch-label">饮酒</view>
              <switch checked="{{form.drink}}" color="#0F766E" bindchange="onDrink" />
            </view>
            <view class="field">
              <view class="t-label">运动频率</view>
              <picker range="{{sports}}" value="{{sportIndex}}" bindchange="onSport">
                <view class="picker-box">
                  <view wx:if="{{form.sport}}">{{form.sport}}</view>
                  <view wx:else class="placeholder">请选择运动频率</view>
                </view>
              </picker>
            </view>
          </view>


        </block>
        <block wx:else>
          <view class="card " >
            <view class="t-h2" >健康档案暂不可编辑</view>
            <view class="t-p " >已有档案可本人查看。删除或相关问题可通过平台客服渠道了解。</view>
          </view>
          <view class="card " wx:if="{{hasExistingProfile}}">
            <view class="t-h2" >已有档案 · 仅本人查看</view>
            <view class="kv" wx:for="{{readOnlyRows}}" wx:key="label">
              <text class="t-span">{{item.label}}</text>
              <text class="t-b">{{item.value}}</text>
            </view>
          </view>
          <view class="" wx:else>
            <view class="empty-card" >
              <text class="ph ph-identification-card">
              </text>
              <view class="t-h2" >暂无可查看的健康档案</view>
              <view class="t-p hf-empty-text" >档案开放状态以当前页面提示为准。</view>
              <button class="secondary" bindtap="hfGo" data-url="/pages/my/my">返回我的</button>
            </view>
          </view>
        </block>
        <button class="text-action" bindtap="openPrivacy" >阅读隐私政策</button>
        <view class="footer-note" >健康档案属于敏感个人信息，请谨慎提供</view>
      </view>
    </block>
    <view class="actions" wx:if="{{profileMode === 'demo' && !loading && !statusUnavailable}}">
      <button class="primary" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存演示档案'}}</button>
    </view>
    <privacy-consent />
</view>

</block>
