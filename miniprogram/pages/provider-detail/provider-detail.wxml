<block wx:if="{{!accessBlocked}}">
<view class="hf {{(provider && !loading && !error) ? 'has-actions' : ''}}" style="padding-top:calc(14.871794872vw + {{hfStatus}}px)">
  <view class="hf-nav" style="top:0">
    <view class="hf-status" style="height:{{hfStatus}}px">
    </view>
    <view class="hf-nav-inner" >
      <button class="hf-back" bindtap="hfBack" >返回</button>
      <view class="hf-nav-title" >{{hfTitle}}</view>
    </view>
  </view>
  <block wx:if="{{needLogin}}">
    <view class="hero with-icon" >
      <text class="eyebrow">杏临汇 · 个人服务</text>
      <view class="t-h1" >登录后继续</view>
      <view class="t-p " >个人记录仅向当前登录账户展示</view>
      <view class="hero-icon" >
        <text class="ph ph-lock-key">
        </text>
      </view>
    </view>
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-user-circle">
        </text>
        <view class="t-h2" >登录后查看{{hfTitle}}</view>
        <view class="t-p hf-empty-text" >前往「我的」完成登录后，再回来查看相关信息。</view>
        <button class="primary" bindtap="hfGo" data-url="/pages/my/my">前往登录</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:elif="{{loading && (!list || !list.length)}}">
    <view class="pad" >
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
      <view class="skeleton" >
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
        <view class="t-span" >
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{(error && (!list || !list.length)) || statusUnavailable}}">
    <view class="pad" >
      <view class="empty-card" >
        <text class="ph ph-cloud-slash">
        </text>
        <view class="t-h2" >暂时无法加载内容</view>
        <view class="t-p hf-empty-text" >{{error || statusMessage}}</view>
        <button class="secondary" bindtap="hfRetry" >重新加载</button>
      </view>
      <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
    </view>
  </block>
  <block wx:else>
    <view class="hero " >
      <text class="eyebrow">人员资料 · 资料展示</text>
      <view class="t-h1" >{{provider.name || '人员资料'}}</view>
      <view class="t-p " >{{provider.dept || '健康管理相关方向'}}</view>
    </view>
    <view class="pad" >
      <view class="notice " >
        <text class="ph ph-info">
        </text>
        <view class="t-p " >人员身份与资质待核验，不代表实际服务能力。</view>
      </view>
      <view class="card " >
        <view class="t-h2" >人员资料</view>
        <view class="kv" >
          <text class="t-span">职称</text>
          <text class="t-b">待核验</text>
        </view>
        <view class="kv" >
          <text class="t-span">执业单位</text>
          <text class="t-b">待核验</text>
        </view>
        <view class="kv" >
          <text class="t-span">从业年限</text>
          <text class="t-b">待核验</text>
        </view>
      </view>
      <view class="card " >
        <view class="t-h2" >个人简介</view>
        <view class="t-p " >{{provider.intro || '人员介绍正在完善。完成身份、资质与服务范围核验后，再展示可确认的信息。'}}</view>
        <view class="tags" >
          <text class="t-span" wx:for="{{provider.skills}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="card " >
        <view class="t-h2" >预约时段</view>
        <block wx:if="{{slots.length}}">
          <view class="t-p small" >仅用于流程设计，不代表真实排班。</view>
          <view class="quiet" wx:for="{{slots}}" wx:key="date">
            <text class="ph ph-calendar-blank">
            </text>
            <view class="" >
              <view class="t-h3" >{{item.label}} · {{item.week}}</view>
              <view class="t-p " >{{item.periods}}</view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="quiet" >
            <text class="ph ph-calendar-blank">
            </text>
            <view class="t-p " >真实排班尚未接入
              预约暂未开放</view>
            </view>
          </block>
        </view>
        <view class="card " >
          <view class="t-h2" >服务评价</view>
          <view class="t-p" wx:if="{{!reviews.length}}">暂无可核实的服务评价。</view>
          <view class="receipt" wx:for="{{reviews}}" wx:key="id">
            <view class="t-h3">{{item.userName}} · 历史评价</view>
            <view class="t-p">{{item.content}}</view>
            <text class="t-small">{{item.time}}</text>
          </view>
        </view>
        <view class="footer-note" >健康管理与信息服务，不替代诊疗</view>
      </view>
    </block>
    <view class="actions" wx:if="{{provider && !loading && !error}}">
      <button class="secondary" bindtap="goChat" disabled="{{!slots.length}}">{{slots.length ? '体验演示留言' : '留言暂未开放'}}</button>
      <button class="primary" bindtap="goBook" disabled="{{!slots.length}}">{{slots.length ? '查看演示预约' : '预约暂未开放'}}</button>
    </view>
  </view>

</block>
