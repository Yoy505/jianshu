<view class="hf hf-tab" style="padding-top:{{hfStatus}}px">
  <view class="account-hero" >
    <view class="brandbar" >
      <image class="t-img" src="/assets/brand/xinglinhui-mark.png" mode="aspectFit" />
      <text class="t-strong">我的</text>
      <text class="t-span">杏临汇</text>
    </view>
    <view class="account-intro" >
      <text class="eyebrow">健康记录 · 服务随行</text>
      <view class="t-h1" >我的健康空间</view>
      <view class="t-p " >所需信息，清晰归在一处</view>
    </view>
  </view>
  <view class="account-content" >
    <view class="identity" >
      <text class="ph ph-user-circle">
      </text>
      <view class="identity-copy" >
        <view class="t-h2" >{{logged ? (user.nickname || '杏临汇用户') : '欢迎来到杏临汇'}}</view>
        <view class="t-p " >{{logged ? (user.phone || '未绑定手机号') : '登录后查看个人记录与服务进展'}}</view>
      </view>
      <button class="primary compact" bindtap="hfOpenLogin" wx:if="{{!logged}}">立即登录</button>
    </view>
    <view class="profile-card" >
      <view class="profile-head" >
        <view class="" >
          <text class="ph ph-identification-card">
          </text>
          <view class="t-h2" >健康档案</view>
        </view>
        <text class="t-span">{{!logged ? '未登录' : (hfProfileError ? '加载失败' : (profile ? '已建立' : '未建立'))}}</text>
      </view>
      <view class="t-p " >{{hfProfileError ? '档案状态暂无法确认，请稍后重新加载。' : '已有档案可本人查看；填写状态以档案页面提示为准。'}}</view>
      <view class="profile-foot" >
        <text class="t-span">
          <text class="ph ph-lock-key">
          </text>个人健康信息</text>
          <button class="" bindtap="goProfile" >{{logged ? '查看健康档案' : '登录后查看'}}</button>
        </view>
      </view>
      <view class="section-head" >
        <view class="t-h2" >我的服务</view>
        <text class="t-span">记录与进展，随时查看</text>
      </view>
      <view class="quick-grid" >
        <button class="quick-card" bindtap="goAuthPage" data-url="/pages/appointments/appointments">
          <text class="ph ph-calendar-check">
          </text>
          <view class="t-h3" >我的预约</view>
          <view class="t-p " >查看预约意向与处理状态</view>
        </button>
        <button class="quick-card warm" bindtap="goAuthPage" data-url="/pages/consult-list/consult-list">
          <text class="ph ph-chat-centered-text">
          </text>
          <view class="t-h3" >我的咨询</view>
          <view class="t-p " >查看咨询记录与系统回执</view>
        </button>
        <button class="quick-card" bindtap="goAuthPage" data-url="/pages/orders/orders">
          <text class="ph ph-receipt">
          </text>
          <view class="t-h3" >我的订单</view>
          <view class="t-p " >服务包订单与支付进展</view>
        </button>
        <button class="quick-card warm" bindtap="goAuthPage" data-url="/pages/benefits/benefits">
          <text class="ph ph-seal-check">
          </text>
          <view class="t-h3" >我的权益</view>
          <view class="t-p " >领取权益与服务准备</view>
        </button>
      </view>
      <view class="menu-group" >
        <button class="menu-item" bindtap="goAuthPage" data-url="/pages/favorites/favorites">
          <text class="ph ph-bookmark-simple">
          </text>
          <view class="" >
            <view class="t-h3" >药品收藏</view>
            <view class="t-p " >收藏关注的药品资料</view>
          </view>
          <text class="t-span">查看</text>
        </button>
        <button class="menu-item" bindtap="hfGo" data-url="/pages/certify/certify">
          <text class="ph ph-user-circle-plus">
          </text>
          <view class="" >
            <view class="t-h3" >实名入驻</view>
            <view class="t-p " >专业技术人员入驻意向登记</view>
          </view>
          <text class="t-span">了解</text>
        </button>
        <button class="menu-item" bindtap="contactLogin" open-type="{{logged ? 'contact' : ''}}">
          <text class="ph ph-headset">
          </text>
          <view class="" >
            <view class="t-h3" >联系客服</view>
            <view class="t-p " >平台使用与服务咨询</view>
          </view>
          <text class="t-span">联系</text>
        </button>
      </view>
      <view class="account-actions" >
        <button class="" bindtap="openTerms" >用户协议</button>
        <text class="t-span">
        </text>
        <button class="" bindtap="openPrivacy" >隐私政策</button>
        <button class="" bindtap="logout" wx:if="{{logged}}">退出登录</button>
      </view>
      <view class="disclaimer" >本平台提供健康管理与信息服务，不替代诊疗；
        就医请前往正规医疗机构。</view>
      </view>
      <view class="hf-mask" wx:if="{{loginOpen}}" bindtap="hfCloseLogin">
        <view class="hf-dialog" catchtap="hfNoop">
          <view class="dialog-head" >
            <view class="t-h2" >登录杏临汇</view>
            <button class="" bindtap="hfCloseLogin" >
              <text class="ph ph-x">
              </text>
            </button>
          </view>
          <view class="t-p login-sub">授权微信关联手机号，快捷登录并使用健康服务</view>
          <button wx:if="{{loginAgreed}}" class="primary wx-login" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{wxLoggingIn}}" disabled="{{wxLoggingIn}}">
            <text class="ph ph-wechat-logo"></text>微信手机号快捷登录</button>
          <button wx:else class="primary wx-login" bindtap="requireAgreement">微信手机号快捷登录</button>
          <block wx:if="{{smsMode}}">
            <view class="sms-form">
              <view class="sms-row">
                <input class="sms-input" type="number" maxlength="11" value="{{smsPhone}}"
                  placeholder="手机号" bindinput="onSmsPhone" disabled="{{smsLoggingIn}}" />
                <button class="sms-code-btn {{smsCountdown > 0 ? 'sms-code-wait' : ''}}"
                  bindtap="sendSmsCode" disabled="{{smsCountdown > 0 || smsSending}}">
                  {{smsCountdown > 0 ? smsCountdown + 's 后重发' : '获取验证码'}}</button>
              </view>
              <input class="sms-input sms-code-line" type="number" maxlength="6" value="{{smsCode}}"
                placeholder="6 位验证码" bindinput="onSmsCode" disabled="{{smsLoggingIn}}" />
              <button class="sms-login-btn" bindtap="smsLoginTap"
                loading="{{smsLoggingIn}}" disabled="{{smsLoggingIn}}">验证码登录</button>
            </view>
          </block>
          <view class="login-feedback" wx:if="{{loginError}}">{{loginError}}</view>
          <view class="sms-switch" bindtap="toggleSmsMode">{{smsMode ? '← 返回微信快捷登录' : '微信授权不可用？使用手机号验证码'}}</view>
          <checkbox-group bindchange="onLoginAgreement" class="login-agreement">
            <label><checkbox value="agree" checked="{{loginAgreed}}" color="#0f766e" disabled="{{wxLoggingIn}}"/><text>我已阅读并同意用户协议与隐私政策</text></label>
          </checkbox-group>
            <view class="account-actions" >
              <button class="" bindtap="openTerms" >用户协议</button>
              <button class="" bindtap="openPrivacy" >隐私政策</button>
            </view>
          </view>
        </view>
        <privacy-consent />
</view>
