/* 药品详情 */
.dd-name { font-size: 36rpx; font-weight: 700; line-height: 1.4; margin-right: 16rpx; }
.fav-btn { flex-shrink: 0; }
.dd-tags { margin-top: 16rpx; flex-wrap: wrap; }
.drug-publication { display: inline-block; margin-top: 16rpx; padding: 8rpx 16rpx; border-radius: 8rpx; font-size: 23rpx; font-weight: 600; }
.drug-publication.demo { background: #FFF1E5; color: #A45313; border: 1rpx solid #F3D6B7; }
.drug-publication.published { background: #E8F3EF; color: #0F766E; }
.drug-publication.unknown { background: #F2F4F3; color: #596A64; }
.drug-demo-notice { margin-bottom: 20rpx; padding: 20rpx 24rpx; border-radius: 12rpx; background: #FFF3E7; color: #8F4A10; font-size: 25rpx; line-height: 1.55; }

.brand-slot {
  margin-top: 20rpx;
  background: #FBF3DB;
  border: 1rpx solid #F3E3B8;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}
.brand-slot-label {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #D97706;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.brand-slot-name { font-size: 26rpx; font-weight: 600; color: #B45309; }

.dd-row { display: flex; align-items: flex-start; margin-top: 24rpx; font-size: 27rpx; line-height: 1.55; }
.dd-label { width: 210rpx; flex-shrink: 0; }
.dd-value { flex: 1; min-width: 0; font-weight: 500; word-break: break-all; }
.dd-text { margin-top: 16rpx; font-size: 27rpx; }
.source-copy { display: inline-flex; align-items: center; min-height: 88rpx; margin-top: 20rpx; padding: 0 24rpx; color: #0F766E; background: #E8F3EF; border-radius: 10rpx; font-size: 25rpx; font-weight: 600; }
.source-note { margin-top: 18rpx; color: #667C74; font-size: 23rpx; line-height: 1.55; }
.medical-section-label { margin: 28rpx 4rpx 0; font-size: 28rpx; font-weight: 700; color: #173A36; }

.dd-video { width: 100%; height: 380rpx; border-radius: 16rpx; margin-top: 20rpx; }

.dd-board-actions { justify-content: space-between; margin-top: 16rpx; }
.dd-board-notice { margin-top: 16rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: #F4F7F6; color: #52645F; font-size: 24rpx; line-height: 1.6; }
.board-item { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #F0F1F2; }
.board-user { font-size: 26rpx; font-weight: 600; }
.board-time { font-size: 22rpx; }
.board-content { margin-top: 10rpx; font-size: 26rpx; line-height: 1.7; }
