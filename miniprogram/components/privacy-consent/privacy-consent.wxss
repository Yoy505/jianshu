.pc-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pc-dialog {
  width: 590rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.pc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  text-align: center;
}

.pc-body {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4B5563;
  text-align: justify;
}

.pc-link {
  color: #0F766E;
}

.pc-btn {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.pc-btn-agree {
  background: #0F766E;
  color: #FFFFFF;
  padding: 0;
}

.pc-btn-agree::after {
  border: none;
}

.pc-btn-deny {
  background: #F3F6F5;
  color: #6B7280;
  font-weight: 400;
}
